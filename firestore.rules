rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
// One record per student (students/), however they sign in: GitHub, or a school email and password.
//   the admin (GitHub 5401810, @jd12): everything, including adding teachers
//   a teacher (a teachers/ document for their sign-in email): every student's roster record, and the progress of
//     students in their own courses; they may add or remove only their own courses on a record
//   a student: their own roster record (read), their own progress (read and write)
//   anyone else signed in with GitHub: create a request to be added, and nothing more
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function ghId() {
      return signedIn() && provider() == 'github.com' ? string(request.auth.token.firebase.identities['github.com'][0]) : '';
    }
    function myEmail() { return signedIn() && provider() == 'password' ? request.auth.token.email.lower() : ''; }
    function isAdmin() { return ghId() in ['5401810']; }
    function teacherDoc() { return get(/databases/$(database)/documents/teachers/$(myEmail())); }
    function isTeacher() {
      return isAdmin() || (myEmail() != '' && exists(/databases/$(database)/documents/teachers/$(myEmail())));
    }
    function myCourses() { return isAdmin() ? [] : teacherDoc().data.courses; }
    function teachesAny(courses) { return isAdmin() || (isTeacher() && courses.hasAny(myCourses())); }
    function isStudentOf(s) { return (ghId() != '' && s.ghId == ghId()) || (myEmail() != '' && s.email == myEmail()); }
    function studentRec(id) { return get(/databases/$(database)/documents/students/$(id)).data; }
    function validStudent(d) {
      return d.keys().hasOnly(['name', 'email', 'ghId', 'login', 'courses'])
        && d.name is string && d.name.size() < 120
        && d.email is string && d.email.size() < 200 && d.email == d.email.lower()
        && d.ghId is string && d.login is string && d.courses is list;
    }
    // A teacher may change a record's courses only by adding or removing their own.
    function keepsOthersCourses() {
      return isAdmin() || request.resource.data.courses.toSet().difference(myCourses().toSet())
        == resource.data.courses.toSet().difference(myCourses().toSet());
    }

    match /teachers/{email} {
      allow get: if isAdmin() || myEmail() == email;
      allow list, write: if isAdmin();
    }

    match /students/{id} {
      allow get, list: if isTeacher() || isStudentOf(resource.data);
      allow create: if teachesAny(request.resource.data.courses) && validStudent(request.resource.data);
      allow update: if isTeacher() && validStudent(request.resource.data)
        && (teachesAny(resource.data.courses) || teachesAny(request.resource.data.courses)) && keepsOthersCourses();
      allow delete: if isAdmin() || (isTeacher() && resource.data.courses.toSet().difference(myCourses().toSet()).size() == 0);
    }

    match /progress/{id} {
      // A teacher's own practice is kept under t-<their Firebase uid>.
      allow read, write: if signedIn() && id == 't-' + request.auth.uid && request.resource.size() < 400000;
      allow read: if signedIn() && id == 't-' + request.auth.uid;
      allow read: if isStudentOf(studentRec(id)) || (isTeacher() && teachesAny(studentRec(id).courses));
      allow create, update: if isStudentOf(studentRec(id)) && request.resource.size() < 400000;
      // Teachers move progress when a record gets a school email (gh-<number> becomes the email).
      allow create, delete: if isTeacher() && (isAdmin() || teachesAny(studentRec(id).courses));
    }

    // Teachers' edits to questions. Everyone signed in reads them (the site lays them over the questions); a teacher writes
    // only edits to a deck one of their courses uses. The map lists each deck's courses (courses.js).
    function deckCourses(d) {
      return {'csp-q3': ['csp'], 'csa': ['csa'], 'cyber-u2': ['cyber'], 'whap': ['whap', 'whap-c', 'whap-d'], 'calc': ['calc']}.get(d, []);
    }
    function validEdit(id, d) {
      return d.keys().hasOnly(['deck', 'item', 'fields', 'answer', 'hidden', 'by', 'ts'])
        && d.deck is string && d.item is string && id == d.deck + ':' + d.item
        && d.fields is map && d.by is string && d.by.size() < 200 && d.ts is int
        && (!('answer' in d) || d.answer is int) && (!('hidden' in d) || d.hidden is bool);
    }
    match /edits/{id} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && validEdit(id, request.resource.data) && teachesAny(deckCourses(request.resource.data.deck));
      allow delete: if isTeacher() && teachesAny(deckCourses(resource.data.deck));
    }

    match /cards/{id} {
      allow read, write: if isTeacher();
    }

    match /requests/{id} {
      allow create, update: if ghId() != '' && id == ghId()
        && request.resource.data.keys().hasOnly(['login', 'name', 'ts'])
        && request.resource.data.login is string && request.resource.data.login.size() < 60
        && request.resource.data.name is string && request.resource.data.name.size() < 120;
      allow read, delete: if isTeacher();
    }

    // Before 11/1: read once to move progress and the roster over.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /roster/{id} {
      allow read: if isAdmin();
    }
  }
}
